# Copy to .streamlit/secrets.toml locally, OR paste into the Streamlit Cloud
# "Secrets" pane under your app's settings. Do NOT commit secrets.toml.

ANTHROPIC_API_KEY = "sk-ant-..."
OPENAI_API_KEY    = "sk-..."          # for Whisper (optional if you only use Groq)
GROQ_API_KEY      = "gsk_..."         # for Groq Whisper (fast + cheap, optional)
